generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @default("admin123")
  namaLengkap  String    @default("Administrator Sistem")
  nomorInduk   String?   @default("ADM-001")
  email        String?   @default("admin@smk-alamanah.sch.id")
  noHp         String?
  avatarUrl    String    @default("https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=160&auto=format&fit=crop&q=80")
  role         String    @default("ADMIN")
  statusAktif  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin")
}

model Guru {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @default("pembina123")
  nip          String?   @unique
  namaLengkap  String
  jenisKelamin String    @default("L")
  noHp         String?
  email        String?
  spesialisasi String?
  avatarUrl    String    @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=160&auto=format&fit=crop&q=80")
  role         String    @default("PEMBINA")
  isPembina    Boolean   @default(true)
  isWaliKelas  Boolean   @default(false)
  statusAktif  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  eskulDiampu               Eskul[]
  kelasWali                 Kelas[]
  sesiDibuat                SesiPertemuan[]
  penilaianDiberikan        Penilaian[]
  pengajuanJadwalDibuat     PengajuanJadwal[] @relation("PengajuanPembina")
  pengajuanJadwalDivalidasi PengajuanJadwal[] @relation("VerifikatorKoordinator")

  @@index([role])
  @@index([isPembina])
  @@index([isWaliKelas])
  @@map("guru")
}

model Kelas {
  id          String   @id @default(uuid())
  namaKelas   String   @unique
  tingkat     Int      @default(10)
  jurusan     String   @default("RPL")
  waliKelasId String?
  waliKelas   Guru?    @relation(fields: [waliKelasId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  siswaList   Siswa[]

  @@index([waliKelasId])
  @@map("kelas")
}

model Siswa {
  id           String    @id @default(uuid())
  nis          String    @unique
  nisn         String?   @unique
  passwordHash String    @default("siswa123")
  namaLengkap  String
  jenisKelamin String    @default("L")
  kelasId      String
  kelas        Kelas     @relation(fields: [kelasId], references: [id], onDelete: Restrict)
  email        String?
  noHp         String?
  noHpOrtu     String?
  alamat       String?
  avatarUrl    String    @default("https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=160&auto=format&fit=crop&q=80")
  statusSiswa  String    @default("AKTIF")
  statusAktif  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  keanggotaanEskul AnggotaEskul[]
  pendaftaranEskul PendaftaranEskul[]
  presensiList     Presensi[]
  penilaianList    Penilaian[]
  prestasiList     PrestasiLomba[]

  @@index([kelasId])
  @@index([statusAktif])
  @@map("siswa")
}

model Eskul {
  id                  String            @id @default(uuid())
  namaEskul           String            @unique
  kategori            String            @default("Olahraga")
  pembinaId           String
  pembina             Guru              @relation(fields: [pembinaId], references: [id], onDelete: Restrict)
  jadwalHari          String
  jamMulai            String
  jamSelesai          String
  lokasi              String
  kuota               Int               @default(40)
  status              String            @default("Aktif")
  deskripsi           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  anggota             AnggotaEskul[]
  pendaftaranList     PendaftaranEskul[]
  sesiList            SesiPertemuan[]
  penilaian           Penilaian[]
  prestasi            PrestasiLomba[]
  pengajuanJadwalList PengajuanJadwal[]

  @@index([pembinaId])
  @@index([kategori])
  @@map("eskul")
}

model AnggotaEskul {
  id               String   @id @default(uuid())
  eskulId          String
  siswaId          String
  tahunAjaran      String   @default("2026/2027")
  jabatan          String   @default("ANGGOTA")
  status           String   @default("AKTIF")
  tanggalBergabung DateTime @default(now())

  eskul            Eskul    @relation(fields: [eskulId], references: [id], onDelete: Cascade)
  siswa            Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([eskulId, siswaId, tahunAjaran])
  @@index([eskulId])
  @@index([siswaId])
  @@map("anggota_eskul")
}

model PendaftaranEskul {
  id                 String    @id @default(uuid())
  eskulId            String
  siswaId            String
  tahunAjaran        String    @default("2026/2027")
  status             String    @default("MENUNGGU_SELEKSI")
  alasanDaftar       String?   @default("Berminat mengembangkan minat dan bakat")
  catatanPembina     String?
  catatanKoordinator String?
  diajukanPada       DateTime?
  divalidasiPada     DateTime?
  divalidasiOlehId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eskul              Eskul     @relation(fields: [eskulId], references: [id], onDelete: Cascade)
  siswa              Siswa     @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([eskulId, siswaId, tahunAjaran])
  @@index([eskulId])
  @@index([siswaId])
  @@index([status])
  @@map("pendaftaran_eskul")
}

model SesiPertemuan {
  id             String     @id @default(uuid())
  eskulId        String
  pembuatId      String?
  tanggal        String
  jamMulai       String     @default("15:30")
  jamSelesai     String     @default("17:00")
  lokasi         String?
  judul          String?
  deskripsi      String?
  materi         String?
  fotoKegiatan   String?
  tokenAktif     String?
  tokenExpiresAt DateTime?
  status         String     @default("BERLANGSUNG")
  isLibur        Boolean    @default(false)
  alasanLibur    String?
  isLocked       Boolean    @default(false)
  lockedAt       DateTime?
  createdAt      DateTime   @default(now())

  eskul          Eskul      @relation(fields: [eskulId], references: [id], onDelete: Cascade)
  pembuat        Guru?      @relation(fields: [pembuatId], references: [id], onDelete: SetNull)
  presensiList   Presensi[]

  @@index([eskulId])
  @@index([tanggal])
  @@index([status])
  @@map("sesi_pertemuan")
}

model Presensi {
  id              String        @id @default(uuid())
  sesiId          String
  siswaId         String
  waktuScan       DateTime      @default(now())
  status          String        @default("HADIR")
  metode          String        @default("DYNAMIC_QR")
  keterangan      String?
  nilaiKeaktifan  Float?        @default(85.0)
  ratingKeaktifan String?       @default("Sangat Baik")
  buktiSurat      String?
  deviceInfo      String?

  sesi            SesiPertemuan @relation(fields: [sesiId], references: [id], onDelete: Cascade)
  siswa           Siswa         @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([sesiId, siswaId])
  @@index([sesiId])
  @@index([siswaId])
  @@index([status])
  @@map("presensi")
}

model Penilaian {
  id                String   @id @default(uuid())
  eskulId           String
  siswaId           String
  penilaiId         String?
  semester          Int      @default(1)
  tahunAjaran       String   @default("2026/2027")
  nilaiKehadiran    Float    @default(90.0)
  nilaiKeaktifan    Float    @default(85.0)
  ratingKeaktifan   String   @default("Sangat Baik")
  nilaiKinerja      Float    @default(85.0)
  poinPrestasi      Float    @default(0.0)
  nilaiAkhir        Float    @default(87.0)
  predikat          String   @default("A")
  capaianKompetensi String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  eskul             Eskul    @relation(fields: [eskulId], references: [id], onDelete: Cascade)
  siswa             Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  penilai           Guru?    @relation(fields: [penilaiId], references: [id], onDelete: SetNull)

  @@unique([eskulId, siswaId, semester, tahunAjaran])
  @@index([eskulId])
  @@index([siswaId])
  @@map("penilaian")
}

model PrestasiLomba {
  id              String   @id @default(uuid())
  eskulId         String
  siswaId         String
  namaLomba       String
  penyelenggara   String?
  tingkat         String   @default("KOTA")
  peringkat       String   @default("JUARA_1")
  tanggal         DateTime @default(now())
  tahunAjaran     String   @default("2026/2027")
  semester        Int      @default(1)
  buktiSertifikat String?
  poinTambahan    Float    @default(10.0)
  keterangan      String?
  diverifikasi    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  eskul           Eskul    @relation(fields: [eskulId], references: [id], onDelete: Cascade)
  siswa           Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@index([siswaId])
  @@index([eskulId])
  @@map("prestasi_lomba")
}

model PengajuanJadwal {
  id                 String    @id @default(uuid())
  eskulId            String
  pembinaId          String
  hariLama           String
  jamMulaiLama       String
  jamSelesaiLama     String
  lokasiLama         String?
  hariBaru           String
  jamMulaiBaru       String
  jamSelesaiBaru     String
  lokasiBaru         String?
  jenisPerubahan     String    @default("PERMANEN")
  tanggalEfektif     String?
  alasan             String
  status             String    @default("MENUNGGU_VALIDASI")
  catatanKoordinator String?
  diverifikasiOlehId String?
  diverifikasiPada   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eskul              Eskul     @relation(fields: [eskulId], references: [id], onDelete: Cascade)
  pembina            Guru      @relation("PengajuanPembina", fields: [pembinaId], references: [id], onDelete: Cascade)
  diverifikasiOleh   Guru?     @relation("VerifikatorKoordinator", fields: [diverifikasiOlehId], references: [id], onDelete: SetNull)

  @@index([eskulId])
  @@index([pembinaId])
  @@map("pengajuan_jadwal")
}
