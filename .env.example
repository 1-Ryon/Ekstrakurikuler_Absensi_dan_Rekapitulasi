# ==============================================================
# SMK AL AMANAH - SISTEM PRESENSI & PENILAIAN EKSTRAKURIKULER
# Template Variabel Lingkungan (Salin ke .env sebelum menjalankan)
# ==============================================================

# Backend Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Database Connection
# Default SQLite lokal di folder backend/prisma/dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret untuk Autentikasi Sesi (Ganti dengan string acak panjang di production)
JWT_SECRET=al_amanah_super_secret_jwt_key_2026_change_in_production

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Frontend Vite API Base URL (Untuk deployment frontend)
VITE_API_BASE_URL=http://localhost:5000/api
