{
  "name": "absensi-pkm-workspace",
  "version": "1.0.0",
  "description": "Sistem Informasi Presensi Dynamic QR & Penilaian Ekstrakurikuler SMK Al Amanah",
  "scripts": {
    "dev": "npx concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "start": "npx concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "kill:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 5000,3000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "tunnel": "cloudflared tunnel --edge-ip-version 4 run --token eyJhIjoiN2NhNzRlMzI5YmQyYzRlMjU1OTJlNTQ2ZjE5MjNjNzgiLCJ0IjoiOTJmOTg3ZGItNjQ2YS00NDA4LWI3NjItZDM1MmJjZjhhNTI2IiwicyI6Ik9XTXlaV05sTXprdE9HSXdOeTAwTUdJM0xXSTNZVGN0TmprM09HTTRaRFEzT0RkaCJ9",
    "tunnel:token": "cloudflared tunnel --edge-ip-version 4 run --token eyJhIjoiN2NhNzRlMzI5YmQyYzRlMjU1OTJlNTQ2ZjE5MjNjNzgiLCJ0IjoiOTJmOTg3ZGItNjQ2YS00NDA4LWI3NjItZDM1MmJjZjhhNTI2IiwicyI6Ik9XTXlaV05sTXprdE9HSXdOeTAwTUdJM0xXSTNZVGN0TmprM09HTTRaRFEzT0RkaCJ9",
    "tunnel:quick": "cloudflared tunnel --edge-ip-version 4 --url http://localhost:3000",
    "tunnel:try": "cloudflared tunnel --edge-ip-version 4 --url http://localhost:3000",
    "update": "./update.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:migrate": "cd backend && npx prisma db push",
    "db:seed": "cd backend && node prisma/seed.js",
    "db:seed:eskul": "cd backend && node prisma/seed-eskul.js",
    "db:studio": "cd backend && npx prisma studio",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
